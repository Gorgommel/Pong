        <mxCell id="Y5kbWOOBGGrftG058avu-10" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1E40AF;" value="HiveMQ Cloud Broker" vertex="1">
