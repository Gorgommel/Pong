        <mxCell id="Y5kbWOOBGGrftG058avu-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=14;" value="MQTT TLS: 8883&#xa;MQTT over WebSocket seguro: 8884/mqtt&#xa;Autenticação: pong-backend • pong-frontend • pong-esp32" vertex="1">
          <mxGeometry height="90" width="500" x="550" y="255" as="geometry" />
        </mxCell>
        <mxCell id="Y5kbWOOBGGrftG058avu-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#60A5FA;fontSize=14;fontFamily=Courier New;" value="TÓPICOS PRINCIPAIS&#xa;&#xa;pong/sala1/+/movimento        QoS 0&#xa;pong/sala1/estado              QoS 0&#xa;pong/sala1/placar              QoS 1&#xa;pong/sala1/comandos            QoS 1&#xa;pong/sala1/chat                QoS 1&#xa;pong/sala1/status/+            QoS 1 + Retained + LWT&#xa;pong/sala1/estado_critico      QoS 2 + Retained" vertex="1">
          <mxGeometry height="200" width="500" x="550" y="370" as="geometry" />
        </mxCell>
        <mxCell id="Y5kbWOOBGGrftG058avu-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;arcSize=8;" value="" vertex="1">
